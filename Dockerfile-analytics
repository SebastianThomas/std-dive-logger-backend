# Stage 1: Build
FROM maven:3.9.11-eclipse-temurin-25 AS build

WORKDIR /app

# Copy only the files needed for dependencies first (for caching)
COPY std-dive-logger-backend/pom.xml ./pom.xml
COPY std-dive-logger-backend/std-dive-logger-model/pom.xml ./std-dive-logger-model/pom.xml
COPY std-dive-logger-backend/std-dive-logger-data/pom.xml ./std-dive-logger-data/pom.xml
COPY std-dive-logger-backend/std-dive-logger-service/pom.xml ./std-dive-logger-service/pom.xml
COPY std-dive-logger-backend/std-dive-logger-import-service/pom.xml ./std-dive-logger-import-service/pom.xml
COPY std-dive-logger-backend/std-dive-logger-ws/pom.xml ./std-dive-logger-ws/pom.xml
COPY std-dive-logger-backend/std-dive-logger-autocomplete/pom.xml ./std-dive-logger-autocomplete/pom.xml
COPY std-dive-logger-backend/std-dive-logger-analytics/pom.xml ./std-dive-logger-analytics/pom.xml
COPY std-dive-logger-backend/std-dive-logger-coverage/pom.xml ./std-dive-logger-coverage/pom.xml

# Pre-download all dependencies for caching
RUN mvn --batch-mode dependency:go-offline

COPY std-dive-logger-backend/ ./

ARG MODULE_NAME=std-dive-logger-analytics

RUN mvn --batch-mode clean package -pl ${MODULE_NAME} -am \
    -Dconfig.deploy.env=dev -Dconfig.directory=/config -DskipTests

FROM eclipse-temurin:25
LABEL authors="SebastianThomas"
LABEL maintainer="Sebastian Thomas <tsebastian@student.ethz.ch>"

WORKDIR /app
ARG MODULE_NAME=std-dive-logger-analytics

COPY --from=build /app/${MODULE_NAME}/target/*.jar app.jar

ENV SPRING_CONFIG_LOCATION=/config/ \
    SPRING_DOCKER_COMPOSE_ENABLED=false

EXPOSE 5173

ENTRYPOINT ["sh", "-c", "exec java -XX:MinRAMPercentage=60.0 -XX:MaxRAMPercentage=80.0 $ADDITIONAL_JAVA_OPTS -jar /app/app.jar"]
