<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <artifactId>std-dive-logger-backend</artifactId>
        <groupId>ch.sthomas.stddivelogger</groupId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <properties>
        <start-class>ch.sthomas.stddivelogger.ws.StdDiveLoggerWsApplication</start-class>
    </properties>

    <artifactId>std-dive-logger-ws</artifactId>
    <name>Std Dive Logger WS</name>

    <dependencies>
        <dependency>
            <groupId>ch.sthomas.stddivelogger</groupId>
            <artifactId>std-dive-logger-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.sthomas.stddivelogger</groupId>
            <artifactId>std-dive-logger-import-service</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
        </dependency>

        <!-- shared test -->
        <dependency>
            <groupId>ch.sthomas.stddivelogger</groupId>
            <artifactId>std-dive-logger-data</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.sthomas.stddivelogger</groupId>
            <artifactId>std-dive-logger-import-service</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.sthomas.stddivelogger</groupId>
            <artifactId>std-dive-logger-service</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
