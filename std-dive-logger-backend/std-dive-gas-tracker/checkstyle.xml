<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- Enforces AGENTS.md "Java code style" (task Q1). Only these rules; formatting is Spotless. -->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>

    <module name="TreeWalker">
        <module name="FinalParameters">
            <property name="tokens" value="METHOD_DEF, CTOR_DEF, LITERAL_CATCH"/>
        </module>

        <module name="FinalLocalVariable">
            <property name="tokens" value="VARIABLE_DEF"/>
            <property name="validateEnhancedForLoopVariable" value="true"/>
        </module>

        <!-- Explicit reference type on a local (also `for (` / `try (` variables): use `final var`.
             Matches only lines that start with `final <Type> name =` (or `:` in a for-each), so fields
             (modifier first), records, parameters, enum constants and primitives are never hit; a
             package-private field without any modifier would be - give it one. -->
        <module name="RegexpSinglelineJava">
            <property name="id" value="explicitType"/>
            <property name="format"
                      value="^\s+((for|try)\s*\(\s*)?final\s+(?!var\b)([a-z]\w*\.)*[A-Z][\w.]*(&lt;[^=]*&gt;)?(\[\])*\s+\w+\s*[=:]"/>
            <property name="message" value="Use ''final var'' for local variables (AGENTS.md Java code style)"/>
            <property name="ignoreComments" value="true"/>
        </module>

        <!-- `// checkstyle: explicit-type <reason>` silences the comment line and the next one. -->
        <module name="SuppressWithNearbyCommentFilter">
            <property name="commentFormat" value="checkstyle: explicit-type (.+)"/>
            <property name="checkFormat" value="RegexpSinglelineJavaCheck"/>
            <property name="idFormat" value="explicitType"/>
            <property name="influenceFormat" value="1"/>
        </module>
    </module>
</module>
